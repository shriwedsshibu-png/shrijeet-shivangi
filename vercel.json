{
  "rewrites": [
    {
      "source": "/invite/parivaar",
      "destination": "/invite/parivaar/index.html"
    },
    {
      "source": "/invite/shubh-vivah",
      "destination": "/invite/shubh-vivah/index.html"
    },
    {
      "source": "/invite/shrijeet/parivaar",
      "destination": "/invite/shrijeet/parivaar/index.html"
    },
    {
      "source": "/invite/shrijeet/shubh-vivah",
      "destination": "/invite/shrijeet/shubh-vivah/index.html"
    },
    {
      "source": "/invite/shivangi/parivaar",
      "destination": "/invite/shivangi/parivaar/index.html"
    },
    {
      "source": "/invite/shivangi/shubh-vivah",
      "destination": "/invite/shivangi/shubh-vivah/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}